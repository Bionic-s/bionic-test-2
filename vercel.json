{
  "version": 2,
  "outputDirectory": "dist",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/ar/(.*)", "destination": "/index.html" },
    { "source": "/((?!assets|favicon|icon-|manifest|og-image|sitemap|robots).*)", "destination": "/index.html" }
  ]
}
